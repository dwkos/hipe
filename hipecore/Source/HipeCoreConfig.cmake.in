@PACKAGE_INIT@
@QTWEBKIT_PACKAGE_INIT@

find_dependency_with_major_and_minor(@HIPE_QT@Core @HIPE_QT_VERSION_MAJOR@ @HIPE_QT_VERSION_MINOR@)
find_dependency_with_major_and_minor(@HIPE_QT@Gui @HIPE_QT_VERSION_MAJOR@ @HIPE_QT_VERSION_MINOR@)

include("${CMAKE_CURRENT_LIST_DIR}/HipeCoreTargets.cmake")

set(_HipeCore_MODULE_DEPENDENCIES "Gui;Core")
set(HipeCore_DEFINITIONS -DQT_WEBKIT_LIB)

@QTWEBKIT_PACKAGE_FOOTER@
